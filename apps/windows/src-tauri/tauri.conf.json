{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Personal AI OS - Windows Agent",
  "version": "0.1.0",
  "identifier": "com.personalai.windows",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Personal AI OS - Windows Agent",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws: wss: http: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IFBlcnNvbmFsIEFJIE9TIENJIFJlbGVhc2UgS2V5ClJXVGF5T1NQVUNxL3RBMlJ4dXZwNTRsQ0wzMVpxVzFXN09hUXd4TXFpRHV2cGF3WjhhQ2lVUkJvCg==",
      "endpoints": [
        "https://github.com/Rizky0606/AI-Agent/releases/latest/download/latest.json"
      ]
    }
  }
}
