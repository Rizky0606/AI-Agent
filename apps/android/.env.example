# Personal AI OS - Android Client Environment Configuration
# API Base Endpoint (HTTP / HTTPS)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# WebSocket Base Endpoint (WS / WSS) - Derived from API URL if not specified
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:3000

# Firebase Cloud Messaging (FCM) Credentials
# Kosongkan jika kredensial FCM belum dikonfigurasi. Sistem akan otomatis menandai FCM sebagai 'inactive'.
# EXPO_PUBLIC_FCM_ENABLED=false
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_APP_ID=
