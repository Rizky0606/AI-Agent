{
  "name": "personal-ai-os",
  "private": true,
  "type": "module",
  "version": "0.3.0",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:live": "turbo run test:live",
    "test:ci": "pnpm -r lint && pnpm -r typecheck && pnpm -r test && pnpm -r build && pnpm verify:audit",
    "verify:audit": "node --experimental-strip-types scripts/verify-audit-refs.ts",
    "check:tokens": "node --experimental-strip-types scripts/check-design-tokens.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.3",
    "eslint": "^9.25.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1"
  }
}
