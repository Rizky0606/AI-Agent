[Unit]
Description=Personal AI OS host runtime bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/personal-ai-os
Environment=NODE_ENV=production
Environment=RUNTIME_BRIDGE_BIND=172.20.0.1
Environment=RUNTIME_BRIDGE_PORT=9120
Environment=RUNTIME_WORKSPACE_ROOT=/srv/aios/workspaces
Environment=RUNTIME_BRIDGE_TOKEN_FILE=/etc/personal-ai-os/runtime-bridge.token
ExecStart=/home/ubuntu/.local/bin/node /home/ubuntu/apps/personal-ai-os/apps/runtime-bridge/dist/src/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/aios/workspaces /var/log/personal-ai-os /home/ubuntu/.omp/run /home/ubuntu/.hermes/logs

[Install]
WantedBy=multi-user.target
