FROM node:22-bookworm-slim

WORKDIR /app
RUN corepack enable
# runtime-bridge workspace preparation shells out to git; API hosts integration suites that exercise it
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

# Copy root workspace manifests
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.base.json ./

# Copy all workspace package manifests for reliable frozen-lockfile installation
COPY apps/api/package.json apps/api/package.json
COPY apps/agent-worker/package.json apps/agent-worker/package.json
COPY apps/scheduler/package.json apps/scheduler/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/permissions/package.json packages/permissions/package.json
COPY packages/model-gateway/package.json packages/model-gateway/package.json
COPY packages/agent-core/package.json packages/agent-core/package.json
COPY packages/evaluator/package.json packages/evaluator/package.json
COPY packages/mcp/package.json packages/mcp/package.json
COPY packages/memory/package.json packages/memory/package.json
COPY packages/tools/package.json packages/tools/package.json

# Install production dependencies
RUN pnpm install --frozen-lockfile --prod

# Copy source trees needed by API service
COPY packages packages
COPY apps/api apps/api
COPY apps/scheduler apps/scheduler

# Run as non-root user
RUN chown -R node:node /app
USER node

EXPOSE 3000

CMD ["node", "--experimental-strip-types", "apps/api/src/index.ts"]
