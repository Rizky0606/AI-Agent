FROM node:22-bookworm-slim

WORKDIR /app
RUN corepack enable
# runtime-bridge workspace preparation shells out to git for repo init and task branches
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

# Copy root workspace manifests
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.base.json ./

# Copy all workspace package manifests for reliable frozen-lockfile installation
COPY apps/api/package.json apps/api/package.json
COPY apps/agent-worker/package.json apps/agent-worker/package.json
COPY apps/scheduler/package.json apps/scheduler/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/permissions/package.json packages/permissions/package.json
COPY packages/model-gateway/package.json packages/model-gateway/package.json
COPY packages/agent-core/package.json packages/agent-core/package.json
COPY packages/evaluator/package.json packages/evaluator/package.json
COPY packages/mcp/package.json packages/mcp/package.json
COPY packages/memory/package.json packages/memory/package.json
COPY packages/tools/package.json packages/tools/package.json

# Install production dependencies
RUN pnpm install --frozen-lockfile --prod

# Browser tooling: Chromium plus its shared-library set. Installed as root into a
# world-readable path so the non-root `node` user can launch it. The exec runs from
# the workspace that owns the playwright dependency.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN cd apps/agent-worker \
 && pnpm exec playwright install --with-deps chromium \
 && rm -rf /var/lib/apt/lists/* \
 && chmod -R 755 /ms-playwright

# Copy source trees needed by worker service
COPY packages packages
COPY apps/api apps/api
COPY apps/agent-worker apps/agent-worker
COPY apps/scheduler apps/scheduler

# Run as non-root user
# Coding task workspaces live on a named volume mounted here. Creating the directory with the
# right ownership in the image is what makes a fresh volume writable by the non-root user.
RUN mkdir -p /app/data/workspaces
RUN chown -R node:node /app
USER node

CMD ["node", "--experimental-strip-types", "apps/agent-worker/src/index.ts"]
