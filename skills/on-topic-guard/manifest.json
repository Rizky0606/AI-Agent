{
  "name": "on-topic-guard",
  "version": "1.0.0",
  "description": "Memvalidasi keselarasan tindakan atau luaran agen dengan tujuan (goal) dan acceptance criteria pengguna untuk mencegah halusinasi dan deviasi konteks.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "goal": { "type": "string" },
      "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
      "proposedActionOrOutput": { "type": "string" }
    },
    "required": ["goal", "acceptanceCriteria", "proposedActionOrOutput"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "isOnTopic": { "type": "boolean" },
      "alignmentScore": { "type": "number" },
      "deviationReason": { "type": "string" },
      "suggestions": { "type": "array", "items": { "type": "string" } }
    },
    "required": ["isOnTopic", "alignmentScore"]
  },
  "toolRequirements": [],
  "permissions": [
    {
      "action": "query:on_topic_check",
      "resource": "task://intent",
      "scope": "workspace",
      "riskLevel": "LOW",
      "reason": "Pemeriksaan konsistensi semantik tugas terhadap tujuan utama."
    }
  ],
  "compatibility": {
    "agentCoreVersion": ">=0.2.0",
    "platforms": ["node", "linux", "windows"]
  },
  "metadata": {
    "category": "governance",
    "author": "personal-ai-os"
  }
}
