NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
DATABASE_URL=postgresql://personal_ai_os:change-me@postgres:5432/personal_ai_os
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
NINEROUTER_API_KEY=replace-with-9router-api-key

# Database container setup
POSTGRES_DB=personal_ai_os
POSTGRES_USER=personal_ai_os
POSTGRES_PASSWORD=replace-with-secure-postgres-password

# Caddy reverse proxy & TLS
ACME_EMAIL=admin@example.com
PUBLIC_HOSTNAME=ai.example.com
