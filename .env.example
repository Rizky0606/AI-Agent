NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000

# Database credentials
# DATABASE_URL dan POSTGRES_PASSWORD wajib sinkron menggunakan nilai kredensial yang sama.
POSTGRES_DB=personal_ai_os
POSTGRES_USER=personal_ai_os
POSTGRES_PASSWORD=replace-with-secure-postgres-password
DATABASE_URL=postgresql://personal_ai_os:replace-with-secure-postgres-password@postgres:5432/personal_ai_os

# Redis & Authentication
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# 9Router Model Gateway Configuration
# Catatan penting per docs/verification/9router.md:
# Endpoint https://9router.ojixx.my.id/v1 terverifikasi dapat dijangkau via HTTPS (status 401 tanpa token).
# Daftar model berstatus 'belum diuji' tanpa bearer key valid; dilarang menebak model.
# Jalankan `node --experimental-strip-types scripts/verify-9router.ts` dengan NINEROUTER_API_KEY terpasang,
# lalu isi DEFAULT_CHAT_MODEL dengan ID model aktual hasil probe GET /models.
NINEROUTER_BASE_URL=https://9router.ojixx.my.id/v1
NINEROUTER_API_KEY=replace-with-9router-api-key
NINEROUTER_TIMEOUT_MS=30000
DEFAULT_CHAT_MODEL=
# MODEL_GATEWAY: set ke 'mock' HANYA secara eksplisit untuk testing offline; dilarang jika NODE_ENV=production.
MODEL_GATEWAY=

# Origin browser yang boleh memanggil API (Tauri webview + Vite dev server Windows agent).
CORS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:1420,http://127.0.0.1:1420

# Host runtime bridge; token injected on VPS, never commit a value.
RUNTIME_BRIDGE_URL=http://host.docker.internal:9120
RUNTIME_BRIDGE_TOKEN=
RUNTIME_PREFERRED=omp
RUNTIME_HEALTH_INTERVAL_MS=30000

# Storage & Quotas
ARTIFACTS_DIR=data/artifacts
ARTIFACT_USER_QUOTA_BYTES=104857600
SKILLS_DIR=skills

# MCP servers (worker only). JSON array; empty or unset registers none.
# Each entry launches a local process, so this is a deployment-time control and must
# never be driven by end-user input. `capability` is the single capability granted to
# every tool the server exposes; tools outside it are filtered out at registration.
# Every registered tool is classified MEDIUM with scope `external_mcp`, so calls require
# user approval.
# MCP_SERVERS=[{"id":"docs","command":"npx","args":["-y","@acme/mcp-docs"],"capability":"docs:read"}]
MCP_SERVERS=

# Browser tool (worker only; requires the Playwright Chromium download)
BROWSER_TOOL_ENABLED=true
BROWSER_MAX_CONCURRENCY=1
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Caddy reverse proxy & TLS
ACME_EMAIL=admin@example.com
PUBLIC_HOSTNAME=ai.example.com
