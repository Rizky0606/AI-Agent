NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000

# Database credentials
# DATABASE_URL dan POSTGRES_PASSWORD wajib sinkron menggunakan nilai kredensial yang sama.
POSTGRES_DB=personal_ai_os
POSTGRES_USER=personal_ai_os
POSTGRES_PASSWORD=replace-with-secure-postgres-password
DATABASE_URL=postgresql://personal_ai_os:replace-with-secure-postgres-password@postgres:5432/personal_ai_os

# Redis & Authentication
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Google sign-in (Authorization Code + PKCE, server-side). Create an OAuth client of type
# "Web application" in the Google Cloud console, then register GOOGLE_REDIRECT_URI below as an
# authorized redirect URI. Unset or incomplete means `/v1/auth/google/*` answers 503 and only
# email/password login works — never a half-configured flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ai.ojixx.my.id/v1/auth/google/callback
# Where the callback may hand the one-minute login code back to. Exact matches only; loopback
# `http://127.0.0.1:<port>/auth` is always accepted for the desktop agent, whose port is random.
GOOGLE_ALLOWED_REDIRECT_URIS=personal-ai://auth

# 9Router Model Gateway Configuration
# Catatan penting per docs/verification/9router.md:
# Endpoint https://9router.ojixx.my.id/v1 terverifikasi dapat dijangkau via HTTPS (status 401 tanpa token).
# Daftar model berstatus 'belum diuji' tanpa bearer key valid; dilarang menebak model.
# Jalankan `node --experimental-strip-types scripts/verify-9router.ts` dengan NINEROUTER_API_KEY terpasang,
# lalu isi DEFAULT_CHAT_MODEL dengan ID model aktual hasil probe GET /models.
NINEROUTER_BASE_URL=https://9router.ojixx.my.id/v1
NINEROUTER_API_KEY=replace-with-9router-api-key
NINEROUTER_TIMEOUT_MS=30000
DEFAULT_CHAT_MODEL=
# Policy routing models for Auto mode (Sesi 5/6, resolusi otomatis berdasarkan intensi)
AUTO_MODEL_DEFAULT=
AUTO_MODEL_FAST=
AUTO_MODEL_CODING=
AUTO_MODEL_COMPLEX=
AUTO_MODEL_RESEARCH=
# MODEL_GATEWAY: set ke 'mock' HANYA secara eksplisit untuk testing offline; dilarang jika NODE_ENV=production.
MODEL_GATEWAY=

# Origin browser yang boleh memanggil API (Tauri webview + Vite dev server Windows agent).
CORS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:1420,http://127.0.0.1:1420

# Host runtime bridge; token injected on VPS, never commit a value.
RUNTIME_BRIDGE_URL=http://host.docker.internal:9120
RUNTIME_BRIDGE_TOKEN=
RUNTIME_PREFERRED=omp
RUNTIME_HEALTH_INTERVAL_MS=30000

# FCM push notifications. Either the service account JSON itself or a path to it. Needs
# `project_id`, `client_email`, and `private_key`; the access token is obtained through the
# OAuth2 JWT-bearer grant. Unset or incomplete means push delivery is disabled and every
# notification stays internal-only (websocket + `GET /v1/notifications`), never a fake send.
FCM_SERVICE_ACCOUNT_JSON=

# Storage & Quotas
ARTIFACTS_DIR=data/artifacts
ARTIFACT_USER_QUOTA_BYTES=104857600
# Artifact retention sweep (API only). How often expired artifacts are deleted; unset or 0
# disables the sweep entirely. `ephemeral` artifacts live for ARTIFACT_EPHEMERAL_TTL_MS
# (default 86400000 = 24h); `task_duration`/`project_lifetime` artifacts go when their task
# is terminal or their project is gone, and `permanent` ones are never deleted.
ARTIFACT_RETENTION_SWEEP_INTERVAL_MS=0
ARTIFACT_EPHEMERAL_TTL_MS=86400000
SKILLS_DIR=skills

# Parent directory for per-task coding workspaces (worker only). Each coding task gets its own
# git-initialised subdirectory here, and lint/typecheck/test/build run inside it. Must be
# writable by the worker user; docker compose mounts the `coding-workspaces` volume here.
CODING_WORKSPACE_ROOT=/app/data/workspaces

# MCP servers (worker only). JSON array; empty or unset registers none.
# Each entry launches a local process, so this is a deployment-time control and must
# never be driven by end-user input. `capability` is the single capability granted to
# every tool the server exposes; tools outside it are filtered out at registration.
# Every registered tool is classified MEDIUM with scope `external_mcp`, so calls require
# user approval.
# MCP_SERVERS=[{"id":"docs","command":"npx","args":["-y","@acme/mcp-docs"],"capability":"docs:read"}]
MCP_SERVERS=

# Browser tool (worker only; requires the Playwright Chromium download)
BROWSER_TOOL_ENABLED=true
BROWSER_MAX_CONCURRENCY=1
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Per-tool and per-runtime execution caps. Calls beyond a cap fail fast (no queueing), which keeps
# one runaway task from flooding an MCP server or the runtime bridge. Keys: tool name, or
# `runtime:<id>` for bridge calls.
TOOL_MAX_IN_FLIGHT=4
TOOL_MAX_STARTS_PER_MINUTE=600
RUNTIME_MAX_IN_FLIGHT=2
RUNTIME_MAX_STARTS_PER_MINUTE=120

# Device dispatch (API only). Device sessions live in API process memory, so a restart makes an
# online agent look offline. A dispatch waits this long for the agent to dial back before giving
# up with `DeviceOfflineError`, which stops an API restart from burning an approval the user
# already granted. 0 restores the old fail-immediately behaviour.
DEVICE_RECONNECT_GRACE_MS=30000

# Caddy reverse proxy & TLS
ACME_EMAIL=admin@example.com
PUBLIC_HOSTNAME=ai.example.com

# Telegram Alerting (Sesi 16: Notifikasi kesehatan VPS, antrean BullMQ macet, disk usage, backup kadaluwarsa)
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_ALERT_COOLDOWN_MS=300000

# Offsite Encrypted Backup (Sesi 16: Backup terenkripsi AES-256-CBC ke Cloud Object Storage S3/Oracle)
OFFSITE_BACKUP_ENCRYPTION_KEY=
OFFSITE_BACKUP_S3_BUCKET=
OFFSITE_BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
